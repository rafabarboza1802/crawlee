{
    "name": "bc-lead-crawler",
    "version": "0.1.0",
    "private": true,
    "description": "Public business-website crawler for Best Construction's lead-generation pipeline (built on Crawlee).",
    "type": "module",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "crawl": "tsx src/main.ts",
        "discover": "tsx src/discover/main.ts",
