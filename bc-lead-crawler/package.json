        "enrich": "tsx src/enrich/main.ts"
    },
    "dependencies": {
        "cheerio": "1.0.0-rc.12",
        "crawlee": "3.18.2",
        "robots-parser": "3.0.1",
        "zod": "^4.1.0"
    },
    "devDependencies": {
        "@types/node": "^22.0.0",
        "tsx": "^4.20.0",
        "typescript": "^5.9.0",
        "vitest": "^3.2.0"
    }
}
